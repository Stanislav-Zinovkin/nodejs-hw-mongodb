{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Contacts API",
    "description": "API management endpoints"
  },
  "servers": [
    { "url": "https://nodejs-hw-mongodb-contacts-i3qb.onrender.com" }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": ["Contacts"],
        "summary": "Get all contacts",
        "operationId": "getAllContacts",
        "description": "Returns a paginated list of all contacts. Can filter by query parameters.",
        "security": [{"bearerAuth": []}],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Page number" },
          { "name": "perPage", "in": "query", "schema": { "type": "integer", "default": 10 }, "description": "Items per page" },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "enum": ["name","email","phoneNumber"], "default": "name" }, "description": "Field to sort by" },
          { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc","desc"], "default": "asc" }, "description": "Sort order" },
          { "name": "name", "in": "query", "schema": { "type": "string" }, "description": "Filter by contact name (optional)" },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["work","home","personal"] }, "description": "Filter by contact type" },
          { "name": "isFavourite", "in": "query", "schema": { "type": "boolean" }, "description": "Filter by favourite contacts" }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of contacts",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "Successfully found contacts",
                  "data": {
                    "data": [
                      {
                        "name": "John Doe",
                        "phoneNumber": "+123456789",
                        "email": "john@example.com",
                        "photo": "https://example.com/photo.jpg",
                        "isFavourite": true,
                        "contactType": "work"
                      }
                    ],
                    "page": 1,
                    "perPage": 10,
                    "totalItems": 25,
                    "totalPages": 3,
                    "hasPreviousPage": false,
                    "hasNextPage": true
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "status": 401,
                  "message": "Please provide Authorization header",
                  "data": null
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Contacts"],
        "summary": "Create a new contact",
        "operationId": "createContact",
        "description": "Creates a new contact with provided data.",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "phoneNumber": { "type": "string" },
                  "email": { "type": "string" },
                  "isFavourite": { "type": "boolean" },
                  "contactType": { "type": "string", "enum": ["work","home","personal"] },
                  "photo": { "type": "string", "format": "binary" }
                },
                "required": ["name","phoneNumber","contactType"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contact created successfully",
            "content": {
              "application/json": {
                "example": {
                  "status": 201,
                  "message": "Successfully created a contact",
                  "data": {
                    "name": "John Doe",
                    "phoneNumber": "+123456789",
                    "email": "john@example.com",
                    "photo": "https://example.com/photo.jpg",
                    "isFavourite": true,
                    "contactType": "work"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "example": {
                  "status": 400,
                  "message": "Missing required fields",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "status": 401,
                  "message": "Please provide Authorization header",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "get": {
        "tags": ["Contacts"],
        "summary": "Get a contact by ID",
        "operationId": "getContactById",
        "description": "Returns a single contact by ID",
        "security": [{"bearerAuth": []}],
        "parameters": [
          { "name": "contactId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Contact found",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "Successfully found contact with id 12345!",
                  "data": {
                    "name": "John Doe",
                    "phoneNumber": "+123456789",
                    "email": "john@example.com",
                    "photo": "https://example.com/photo.jpg",
                    "isFavourite": true,
                    "contactType": "work"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Contact not found",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "Contact not found",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "status": 401,
                  "message": "Please provide Authorization header",
                  "data": null
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Contacts"],
        "summary": "Update a contact by ID",
        "operationId": "updateContact",
        "description": "Updates one or more fields of an existing contact",
        "security": [{"bearerAuth": []}],
        "parameters": [
          { "name": "contactId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "phoneNumber": { "type": "string" },
                  "email": { "type": "string" },
                  "isFavourite": { "type": "boolean" },
                  "contactType": { "type": "string", "enum": ["work","home","personal"] },
                  "photo": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contact updated successfully",
            "content": {
              "application/json": {
                "example": {
                  "status": 200,
                  "message": "Successfully patched a contact",
                  "data": {
                    "name": "John Doe",
                    "phoneNumber": "+123456789",
                    "email": "john@example.com",
                    "photo": "https://example.com/photo.jpg",
                    "isFavourite": true,
                    "contactType": "work"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "example": {
                  "status": 400,
                  "message": "Missing fields to update",
                  "data": null
                }
              }
            }
          },
          "404": {
            "description": "Contact not found",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "Contact not found",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "status": 401,
                  "message": "Please provide Authorization header",
                  "data": null
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Contacts"],
        "summary": "Delete a contact by ID",
        "operationId": "deleteContact",
        "description": "Deletes a contact by ID",
        "security": [{"bearerAuth": []}],
        "parameters": [
          { "name": "contactId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": {
            "description": "Contact deleted successfully"
          },
          "404": {
            "description": "Contact not found",
            "content": {
              "application/json": {
                "example": {
                  "status": 404,
                  "message": "Contact not found",
                  "data": null
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "status": 401,
                  "message": "Please provide Authorization header",
                  "data": null
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Contact": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "phoneNumber": { "type": "string" },
          "email": { "type": "string" },
          "photo": { "type": "string", "format": "uri" },
          "isFavourite": { "type": "boolean" },
          "contactType": { "type": "string", "enum": ["work","home","personal"] }
        },
        "required": ["name","phoneNumber","contactType"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "integer" },
          "message": { "type": "string" },
          "data": { "type": "object", "nullable": true }
        },
        "required": ["status","message"]
      }
    },
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    }
  }
}
